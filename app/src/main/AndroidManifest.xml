<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- SIM slot detection for per-SIM rules. Optional: without it, SIM-specific
         rules degrade to applying on all SIMs rather than failing. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Removed from the original manifest: FOREGROUND_SERVICE. There is no
         foreground service in this app, and unused permissions draw scrutiny
         in Play review. (Defect D15.) -->

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SpamBlocker">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SpamBlocker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Call screening. This declaration was already correct in the
             original; the defects were all in the implementation. -->
        <service
            android:name=".service.CallBlockerService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!-- Notification suppression for spam SMS. -->
        <service
            android:name=".service.SmsBlockerNotificationService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- NEW. The original registered this at runtime from inside the
             notification listener, so SMS screening only ran while that service
             happened to be bound. SMS_RECEIVED is a protected broadcast and is
             exempt from the Android 8+ implicit-broadcast restrictions, so a
             manifest receiver wakes the app reliably. (Defect D7.) -->
        <receiver
            android:name=".receiver.SmsSpamReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
